# Copy to .env (git-ignored) and replace every placeholder. Never commit real values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studride
DB_USER=studride
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
# Optional managed MySQL connection URL (takes precedence over DB_* when set, e.g. Render / Aiven / Railway):
# DATABASE_URL=mysql://user:password@host:3306/studride?ssl=true
# DB_SSL=false

# Used by backend/database/seed.js on initial account creation: hashed with bcrypt at runtime, never stored in plain text.
# Note: rotating these values after the initial seed does not overwrite existing system account password hashes.
ADMIN_PASSWORD=change-me-admin
MODERATOR_PASSWORD=change-me-moderator

# Must be at least 32 UTF-8 bytes for HS256 signing
JWT_SECRET=change-me-long-random-string-at-least-32-bytes
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Optional comma-separated extra university root domains (e.g. myuni.ro)
EXTRA_UNIVERSITY_DOMAINS=

# Production single-origin SPA serving & reverse-proxy TLS termination (D-021):
# FRONTEND_DIST_DIR=../frontend/dist
# TRUST_PROXY=1
# FORCE_HTTPS=true
